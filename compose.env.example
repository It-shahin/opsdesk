# Docker Compose infrastructure
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5433
REDIS_PORT=6379

# Local production-image smoke testing
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Public Cloudflare R2 endpoint used by the browser.
NEXT_PUBLIC_R2_ORIGIN=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

AUTH0_AUDIENCE=https://api.opsdesk.dev

# API uses development here ONLY because local Docker uses plain HTTP.
# Real production deployment in Phase 11C will use:
# NODE_ENV=production + HTTPS.
API_NODE_ENV=development
