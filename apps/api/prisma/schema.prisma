generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSource {
  MANUAL
  EMAIL
}

enum TicketMessageKind {
  PUBLIC_REPLY
  INTERNAL_NOTE
}

enum TicketMessageAuthorType {
  MEMBER
  CUSTOMER
  SYSTEM
}

enum TicketMessageSource {
  MANUAL
  EMAIL
  SYSTEM
}

enum AttachmentStatus {
  PENDING
  UPLOADED
}

enum WebhookProvider {
  RESEND
}

enum WebhookEventStatus {
  PROCESSED
  IGNORED
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
}

enum AuditAction {
  ORGANIZATION_CREATED

  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  CUSTOMER_RESTORED

  TICKET_CREATED
  TICKET_UPDATED
  TICKET_STATUS_CHANGED
  TICKET_ASSIGNEE_CHANGED
  TICKET_TAG_ADDED
  TICKET_TAG_REMOVED
  TICKET_MESSAGE_CREATED

  TAG_CREATED

  MEMBER_ROLE_CHANGED

  INVITATION_CREATED
  INVITATION_CANCELED
  INVITATION_ACCEPTED
}

enum AuditEntityType {
  ORGANIZATION
  CUSTOMER
  TICKET
  TICKET_MESSAGE
  TAG
  MEMBERSHIP
  INVITATION
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  authProviderId      String       @unique
  email               String       @unique
  name                String?
  avatarUrl           String?
  memberships         Membership[]
  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")
  auditLogs           AuditLog[]   @relation("AuditActorUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Organization {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  slug            String          @unique
  memberships     Membership[]
  invitations     Invitation[]
  customers       Customer[]
  tickets         Ticket[]
  tags            Tag[]
  messages        TicketMessage[]
  attachments     Attachment[]
  emailDeliveries EmailDelivery[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Membership {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  organizationId String @db.Uuid
  role           Role

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedTickets    Ticket[]        @relation("TicketAssignee")
  authoredMessages   TicketMessage[] @relation("TicketMessageAuthor")
  createdAttachments Attachment[]    @relation("AttachmentCreator")
  auditLogs          AuditLog[]      @relation("AuditActorMembership")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  email String
  role  Role

  tokenHash String @unique

  invitedByUserId  String  @db.Uuid
  acceptedByUserId String? @db.Uuid

  expiresAt  DateTime
  acceptedAt DateTime?
  canceledAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedBy User @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  acceptedBy User? @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}

model Customer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name    String
  email   String?
  phone   String?
  company String?
  notes   String?

  archivedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, archivedAt])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model Ticket {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId     String @db.Uuid

  assigneeMembershipId String? @db.Uuid

  subject     String
  description String?

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)
  source   TicketSource   @default(MANUAL)

  resolvedAt DateTime?
  closedAt   DateTime?

  tagLinks        TicketTag[]
  messages        TicketMessage[]
  attachments     Attachment[]
  emailDeliveries EmailDelivery[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  assignee Membership? @relation("TicketAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
  @@map("tickets")
}

model Tag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name           String
  normalizedName String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticketLinks TicketTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@map("tags")
}

model TicketTag {
  ticketId String @db.Uuid
  tagId    String @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

model TicketMessage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid

  authorMembershipId String? @db.Uuid

  kind       TicketMessageKind
  authorType TicketMessageAuthorType
  source     TicketMessageSource

  body String

  attachments   Attachment[]
  emailDelivery EmailDelivery?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorMembership Membership? @relation("TicketMessageAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, ticketId, createdAt])
  @@index([authorMembershipId])
  @@map("ticket_messages")
}

model Attachment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid

  messageId String? @db.Uuid

  createdByMembershipId String? @db.Uuid

  objectKey    String @unique
  originalName String
  contentType  String
  sizeBytes    Int

  status AttachmentStatus @default(PENDING)

  etag       String?
  uploadedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  createdByMembership Membership? @relation("AttachmentCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, ticketId])
  @@index([messageId])
  @@index([createdByMembershipId])
  @@index([organizationId, status, createdAt])
  @@map("attachments")
}

model WebhookEvent {
  id               String             @id @default(uuid()) @db.Uuid
  provider         WebhookProvider
  eventType        String
  providerEntityId String
  webhookMessageId String?
  status           WebhookEventStatus
  reason           String?

  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([provider, eventType, providerEntityId])
  @@index([webhookMessageId])
  @@index([provider, eventType, createdAt])
  @@map("webhook_events")
}

model EmailDelivery {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @db.Uuid
  ticketId       String @db.Uuid
  messageId      String @unique @db.Uuid

  recipientEmail String?

  status EmailDeliveryStatus @default(PENDING)

  providerMessageId String? @unique

  attemptCount Int @default(0)

  lastAttemptAt DateTime?
  lastError     String?

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message      TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([ticketId, createdAt])
  @@index([status, createdAt])
  @@map("email_deliveries")
}

model AuditLog {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  actorUserId       String? @db.Uuid
  actorMembershipId String? @db.Uuid
  actorRole         Role?

  action     AuditAction
  entityType AuditEntityType
  entityId   String? @db.Uuid

  metadata Json?

  organization Organization @relation(fields: [organizationId],references: [id],onDelete: Cascade)

  actorUser User? @relation("AuditActorUser",fields: [actorUserId],references: [id],onDelete: SetNull)

  actorMembership Membership? @relation("AuditActorMembership",fields: [actorMembershipId],references: [id],onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])

  @@map("audit_logs")
}
