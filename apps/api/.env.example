# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.


NODE_ENV=development
PORT=3001

WEB_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/DATABASE"
REDIS_URL="redis://127.0.0.1:6379"

AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=https://api.opsdesk.dev

R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=opsdesk-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

RESEND_API_KEY=
RESEND_INBOUND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_NAME=OpsDesk Support
EMAIL_FROM_ADDRESS=
EMAIL_INBOUND_DOMAIN=